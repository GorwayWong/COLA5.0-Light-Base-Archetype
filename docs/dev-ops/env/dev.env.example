COMPOSE_PROJECT_NAME=project-dev
POSTGRES_DB=project
POSTGRES_USER=project
POSTGRES_PASSWORD=project_dev_password
POSTGRES_PORT=5432
REDIS_PASSWORD=project_dev_redis_password
REDIS_PORT=6379
SPRING_PROFILES_ACTIVE=dev
# Host JVM configuration; app Compose uses postgres/redis service names.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/project
SPRING_DATASOURCE_USERNAME=project
SPRING_DATASOURCE_PASSWORD=project_dev_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=project_dev_redis_password
APP_IMAGE=project-bootstrap:local
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
DB_POOL_MAX_SIZE=10
