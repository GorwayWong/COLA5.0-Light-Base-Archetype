<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.xaspire</groupId>
    <artifactId>tolink</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tolink-parent</name>
    <description>ToLink modular monolith parent and reactor</description>

    <modules>
        <module>tolink-shared</module>
        <module>tolink-agent</module>
        <module>tolink-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- Boot 3.5.16 manages 11.7.2; 11.20.3 is the latest Flyway 11 GA. -->
        <flyway.version>11.20.3</flyway.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <agentscope.version>2.0.3</agentscope.version>
        <springdoc.version>2.8.17</springdoc.version>
        <archunit.version>1.5.0</archunit.version>
    </properties>
</project>
